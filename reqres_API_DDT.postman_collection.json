		{
			"name": "create_DDT",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"console.log(\"User Credential: \" + pm.iterationData.get('name') + \" & \" + pm.iterationData.get('job'));\r",
							"\r",
							"pm.test(\"User with '\" + pm.iterationData.get(\"name\") + \"' & '\" + pm.iterationData.get(\"job\") + \"' is created successfully\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.name).to.eql(pm.iterationData.get(\"name\"));\r",
							"    pm.expect(jsonData.job).to.eql(pm.iterationData.get(\"job\"));\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.execution.setNextRequest(null);\r",
							"\r",
							"pm.environment.set('name', pm.iterationData.get('name'));\r",
							"pm.environment.set('job', pm.iterationData.get('job'));\r",
							"\r",
							"let name = pm.iterationData.get('name');\r",
							"let job = pm.iterationData.get('job');"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\t\"name\": \"{{name}}\",\r\n    \"job\": \"{{job}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
